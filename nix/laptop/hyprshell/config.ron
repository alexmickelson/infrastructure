(
    version: 4,
    windows: (
        scale: 8.5,
        items_per_row: 5,
        overview: (
            launcher: (
                default_terminal: "ghostty",
                launch_modifier: "ctrl",
                width: 650,
                max_items: 5,
                show_when_empty: true,
                plugins: (
                    applications: (
                        run_cache_weeks: 8,
                        show_execs: true,
                        show_actions_submenu: true,
                    ),
                    terminal: (),
                    shell: None,
                    websearch: None,
                    calc: (),
                    path: (),
                    actions: (
                        actions: [
                            lock_screen,
                            logout,
                            reboot,
                            shutdown,
                            suspend,
                        ],
                    ),
                ),
            ),
            key: "space",
            top_offset: 430,
            modifier: "alt",
            filter_by: [],
            exclude_workspaces: "special:.*",
        ),
        switch: (
            modifier: "alt",
            key: "Tab",
            filter_by: [
                current_monitor,
            ],
            switch_workspaces: false,
            exclude_workspaces: "",
            kill_key: 'q',
        ),
        switch_2: None,
    ),
)
