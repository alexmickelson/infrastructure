[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/png;image/jpeg;image/webp;image/avif;image/gif;image/bmp;image/tiff;
Actions=setWallpaper;chooseWallpaper;
X-KDE-Priority=TopLevel
Name=Set Wallpaper

[Desktop Action setWallpaper]
Name=Set as Wallpaper
Icon=preferences-desktop-wallpaper
Exec=wallpaper-theme %f

[Desktop Action chooseWallpaper]
Name=Choose Wallpaper…
Icon=preferences-desktop-wallpaper
Exec=wallpaper-choose
