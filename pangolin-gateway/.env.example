# Copy this file to .env on the VPS. The resulting .env file is Git-ignored.
#
# Required before the first startup:
# - Generate a unique random value of at least 32 characters.
# - Save it in your VPS secret manager or password manager before deployment.
# - Do not change it after Pangolin starts; use pangctl rotate-server-secret if
#   rotation is required.
SERVER_SECRET=

# Configuration already committed in config/config.yml:
# - Pangolin dashboard DNS name: pangolin.alexmickelson.guru
# - Resource base domain: alexmickelson.guru
# - ACME contact email: admin@alexmickelson.guru
#
# Gather before deployment:
# - A public VPS IPv4 address (and IPv6 if used)
# - DNS control for the dashboard and public resource hostnames
# - Firewall access for TCP 80/443 and UDP 51820/21820
# - The Newt site ID and Newt secret generated later by Pangolin; those belong
#   only in Kubernetes, never in this VPS .env file.
