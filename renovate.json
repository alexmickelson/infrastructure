{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "2 days",
  "branchPrefix": "renovate-",
  "automerge": true,
  "internalChecksAsSuccess": true,
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "kubernetes",
    "argocd",
    "docker-compose"
  ],
  "includePaths": [
    "kubernetes/**/*",
    "pangolin-gateway/**/*"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^kubernetes/.+\\.ya?ml$/"
    ],
    "pinDigests": true
  },
  "argocd": {
    "managerFilePatterns": [
      "/^kubernetes/argocd/apps/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Do not delay Docker digest pinning and refreshes",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alexmickelson/ttyd"],
      "minimumReleaseAge": null
    },
    {
      "description": "Require manual review for PostgreSQL major upgrades",
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
